# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/vapestore_pos_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Cache Layer)
# Format: redis://[:password@]host:port[/database]
# For local development: redis://localhost:6379
# For production with password: redis://:password@hostname:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRY=7d

# Storage Configuration
STORAGE_TYPE=s3
STORAGE_BUCKET=vapestore-pos-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Request Tracking
REQUEST_ID_HEADER=x-request-id

# Environment
IS_PRODUCTION=false
IS_DEVELOPMENT=true
