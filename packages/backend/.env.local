# Local Development Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration (placeholder - will be set up in task 3)
DATABASE_URL=postgresql://localhost/vapestore_pos_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (placeholder - will be set up in task 4)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=dev-refresh-secret-key
JWT_REFRESH_EXPIRY=7d

# Storage Configuration (placeholder - local storage for dev)
STORAGE_TYPE=local
STORAGE_BUCKET=./uploads
STORAGE_REGION=

# Request Tracking
REQUEST_ID_HEADER=x-request-id

# Environment Flags
IS_PRODUCTION=false
IS_DEVELOPMENT=true
