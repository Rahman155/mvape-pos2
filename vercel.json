{
  "version": 2,
  "buildCommand": "cd packages/frontend && pnpm run build",
  "installCommand": "pnpm install --recursive",
  "env": {
    "HUSKY": "0"
  },
  "framework": "nextjs",
  "outputDirectory": ".next",
  "monorepo": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-backend-api.railway.app/api/$1"
    }
  ]
}
